{
  "name": "bleile-glasshouses",
  "version": "1.0.0",
  "private": true,
  "description": "A standalone light-and-shadow game about causal study assumptions.",
  "scripts": {
    "build": "node build.cjs",
    "format": "prettier --write build.cjs \"src/**/*.{js,css}\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check build.cjs \"src/**/*.{js,css}\" \"tests/**/*.cjs\"",
    "test": "node --test tests/model.test.cjs tests/targeting.test.cjs"
  },
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.10.1"
  }
}
