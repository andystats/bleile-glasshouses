# Publish only the game, editable source and portable tests.
/*
!/.gitignore
!/.gitattributes
!/.nojekyll
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/README.md
!/THIRD_PARTY_LICENSES.txt
!/index.html
!/build.cjs
!/package.json
!/package-lock.json
!/src/
/src/*
!/src/index.html
!/src/style.css
!/src/game-content.js
!/src/game-model.js
!/src/scene.js
!/src/app.js
!/src/sounds/
/src/sounds/*
!/src/sounds/*.mp3
!/tests/
/tests/*
!/tests/model.test.cjs
!/tests/targeting.test.cjs
